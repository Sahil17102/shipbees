# Public backend origin used for platform webhook registration.
# Must be HTTPS in production and must not include /api.
API_URL=https://api.shipraylogistics.in

# Browser origins allowed to call the API. Include preview or platform URLs
# here when the frontends are not served from a shipray.com subdomain.
CORS_ALLOWED_ORIGINS=https://shipraylogistics.in,https://www.shipraylogistics.in,https://app.shipraylogistics.in,https://admin.shipraylogistics.in,https://franchise.shipraylogistics.in

# Used in franchise activation emails.
FRANCHISE_PORTAL_URL=https://franchise.shipraylogistics.in

# Delhivery Tracking Push API / Scan Push callback URLs shown in admin courier settings.
# Defaults are derived from API_URL. Override only if Delhivery must use a different public host.
# DELHIVERY_SCAN_PUSH_WEBHOOK_URL=https://api.shipraylogistics.in/api/webhook/delhivery/scan
# DELHIVERY_DOCUMENT_PUSH_WEBHOOK_URL=https://api.shipraylogistics.in/api/webhook/delhivery/document
# DELHIVERY_LEGACY_WEBHOOK_URL=https://api.shipraylogistics.in/api/webhook/delhivery/order

# India Post Bulk Customer API. Keep real credentials only in deployment env.
INDIAPOST_ENV=sandbox
INDIAPOST_API_BASE=https://test.cept.gov.in/beextcustomer
INDIAPOST_MASTERDATA_BASE=https://test.cept.gov.in/bemasterdata
INDIAPOST_USERNAME=
INDIAPOST_PASSWORD=
INDIAPOST_CUSTOMER_ID=
# Issued/subscribed by India Post during UAT onboarding; required for booking.
INDIAPOST_CONTRACT_ID=
INDIAPOST_DROPOFF_OFFICE_ID=
INDIAPOST_TIMEOUT_MS=30000
# Give India Post: https://api.shipraylogistics.in/api/webhooks/indiapost/events
INDIAPOST_WEBHOOK_SECRET=
# Optional comma-separated India Post sender IP allowlist after they provide it.
INDIAPOST_WEBHOOK_ALLOWED_IPS=

# Shopify OAuth app credentials from the Shopify Dev Dashboard.
# The callback host must match the Shopify app's application URL host.
# For the production seller app, add this exact redirect URL in Shopify:
#   https://app.shipraylogistics.in/api/integrations/shopify/oauth/callback
# Set SHOPIFY_OAUTH_REDIRECT_URI to the same value in production.
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_EXPECTED_CLIENT_ID=your_shopify_client_id
SHOPIFY_OAUTH_REDIRECT_URI=https://app.shipraylogistics.in/api/integrations/shopify/oauth/callback
SHOPIFY_INSTALL_AUDIT_LOG_PATH=logs/shopify-install-audit.jsonl
SHOPIFY_BOOTSTRAP_SECRET=optional_shared_secret_for_public_install_bootstrap
SHOPIFY_SCOPES=read_orders,write_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders
SHOPIFY_API_VERSION=2026-07
SHOPIFY_OAUTH_SUCCESS_URL=https://app.shipraylogistics.in/channels/connected
SHOPIFY_USE_EXPIRING_OFFLINE_TOKENS=true
SHOPIFY_DEVELOPMENT_SANDBOX_ENABLED=false
SHOPIFY_REVIEW_STORE_SANDBOX_ENABLED=false
# Leave false when scopes are managed in the Shopify Dev Dashboard app version.
SHOPIFY_SEND_OAUTH_SCOPE=false
# Shopify App Store subscriptions live in courier-cart-client/shopify.app.toml.
# Add the compliance webhook URI there with compliance_topics:
#   customers/data_request, customers/redact, shop/redact
SHOPIFY_PRIVACY_EXPORT_CRON=*/5 * * * *
SHOPIFY_PRIVACY_EXPORT_BATCH_SIZE=10

# Optional emergency-only fallback. Leave disabled for the new OAuth workflow.
SHOPIFY_ALLOW_LEGACY_MANUAL_AUTH=false

# Optional shared fallback secret for WooCommerce webhook HMAC verification.
# The backend generates a per-store secret during connection when this is omitted.
# WOOCOMMERCE_WEBHOOK_SECRET=

# Optional timeout for Shopify/WooCommerce/Magento/Wix platform API calls.
PLATFORM_API_TIMEOUT_MS=15000

# Cloudflare R2 document storage. Keep real keys only in deployment env.
# R2_ENDPOINT may be either the account endpoint or the bucket URL; the backend
# normalizes it before signing requests.
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com/bucket-name
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PROD_BUCKET=bucket-name
STAGING_BUCKET=bucket-name
DEV_BUCKET=bucket-name
# Use a project-specific prefix when sharing one bucket with other projects.
R2_OBJECT_PREFIX=shipray-production

# Optional local-only variables for the WooCommerce credential checker.
# Do not commit real merchant credentials.
# WOOCOMMERCE_STORE_URL=https://yourstore.com
# WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WOOCOMMERCE_CHECK_WRITE=false

# Email sender identity used by the backend mailers.
# Set this to a verified Shipray mailbox in production.
# EMAIL_FROM=noreply@shipray.com
# EMAIL_FROM_NAME=Shipray
# GOOGLE_SMTP_USER=noreply@shipray.com
# GOOGLE_SMTP_PASSWORD=
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Public demo login. SMTP delivery is still attempted, while newly created and
# unfinished customer accounts also receive the OTP on screen. Admin, employee,
# and verified merchant accounts remain email-only. Set false to disable.
AUTH_DEMO_SHOW_OTP=true

# Razorpay is optional at backend startup. Wallet top-ups, reconciliation, and
# penny-drop verification remain unavailable until credentials are configured.
# RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
#
# In live mode, use the production variables below. The generic key variables
# above are also accepted as live fallbacks for deployment platforms.
# RAZORPAY_KEY_ID_PROD=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET_PROD=
# RAZORPAY_WEBHOOK_SECRET_PROD=
# RAZORPAY_SOURCE_ACC=
